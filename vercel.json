{
  "version": 2,
  "outputDirectory": "public",
  "functions": {
    "api/server.mjs": {
      "maxDuration": 240,
      "includeFiles": "lib/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/server?route=:path*"
    },
    {
      "source": "/data/:file",
      "destination": "/api/server?route=research-data/:file"
    },
    {
      "source": "/research",
      "destination": "/index.html"
    },
    {
      "source": "/fantasy",
      "destination": "/index.html"
    },
    {
      "source": "/pricing",
      "destination": "/index.html"
    },
    {
      "source": "/login",
      "destination": "/index.html"
    },
    {
      "source": "/account",
      "destination": "/index.html"
    },
    {
      "source": "/picks",
      "destination": "/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: https://a.espncdn.com; connect-src 'self'; frame-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'"
        }
      ]
    }
  ]
}
